# ============================================================
#  可选环境变量（不想把密钥写进 config.yaml 时用）
#  用法：复制为 .env 并填写；程序启动前在 PowerShell 里加载：
#    Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
# ============================================================

# DeepSeek API Key（config.yaml 里留空时读这个）
DEEPSEEK_API_KEY=sk-你的key

# 国内下载 whisper 模型慢时，指定 HuggingFace 镜像
HF_ENDPOINT=https://hf-mirror.com
